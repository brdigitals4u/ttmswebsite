# TTMS static config snippet for Nginx (FTP-deployed files).
# Include this inside your `server { ... }` block.

# Legacy .html routes are generated from deploy/redirects/legacy-map.json.
include /etc/nginx/snippets/ttms-legacy-redirects.conf;

# Backward-compatible redirect for previously deployed clean URL.
location = /apps/desktop/ { return 308 /; }
location = /apps/desktop { return 308 /; }
location = /company/contact/ { return 308 /contact/; }
location = /company/contact { return 308 /contact/; }

# Clean URL handling for static Eleventy output.
location / {
  try_files $uri $uri/ $uri/index.html =404;
}

# Long-term immutable caching for hashed assets.
location ~* \.(?:css|js|mjs|jpg|jpeg|png|gif|svg|webp|avif|ico|woff2|woff|ttf|eot|mp4)$ {
  add_header Cache-Control "public, max-age=31536000, immutable" always;
  try_files $uri =404;
}

# HTML should be revalidated frequently.
location ~* \.html$ {
  add_header Cache-Control "public, max-age=300, must-revalidate" always;
  try_files $uri =404;
}

# Compression
gzip on;
gzip_comp_level 6;
gzip_min_length 1024;
gzip_vary on;
gzip_proxied any;
gzip_types
  text/plain
  text/css
  text/xml
  application/javascript
  application/json
  application/xml
  image/svg+xml;
